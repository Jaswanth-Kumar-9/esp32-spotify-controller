# Copy this file to .env and fill in your own values locally.
# Never commit .env or Spotify token cache files.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
BRIDGE_API_KEY=choose_a_local_bridge_key

# ESP32 values documented by Spotify_V6.ino
WIFI_SSID=your_wifi_name
WIFI_PASSWORD=your_wifi_password
BRIDGE_HOST=192.168.1.100
BRIDGE_PORT=8888

